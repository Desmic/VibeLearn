{
  "name": "vibelearn-bellweather-arcade-checkpoint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8062 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 8062 --strictPort",
    "check": "tsc --noEmit -p tsconfig.build.json && node tools/storycheck.mjs --root out && node tools/assetcheck.mjs",
    "check:parity": "node tools/rules-parity.mjs",
    "check:play": "node tools/flowcheck.mjs && node tools/breaker.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "playwright": "1.63.0"
  }
}
