      ]
    },
    "predict.near": {
      "when": {
        "op": "eq",
        "left": {
          "field": "phase"
        },
        "right": "predict"
      },
      "effects": [
        {
          "op": "set",
          "field": "phase",
          "value": "build"
        }
      ],
      "emits": [
        "decide:predict-pieces:wrong:near-miss",
        "loom-splits"
      ]
    },
    "predict.letters": {
