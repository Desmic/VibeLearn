    "verb.free": {
      "when": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "left": {
              "field": "phase"
            },
            "right": "build"
          },
          {
            "op": "eq",
            "left": {
              "field": "verb"
            },
            "right": "none"
          }
        ]
      },
      "effects": [
        {
          "op": "set",
          "field": "verb",
          "value": "free"
        },
        {
          "op": "add",
          "field": "pieces",
          "value": 1
        }
      ],
      "emits": [
        "part-placed"
      ]
    },
    "verb.release": {
