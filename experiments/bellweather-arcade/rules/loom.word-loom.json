{
  "schemaVersion": "1",
  "id": "loom.word-loom",
  "version": "2",
  "state": {
    "phase": {
      "type": "enum",
      "values": [
        "guided",
        "predict",
        "build",
        "done"
      ],
      "initial": "guided"
    },
    "lifted": {
      "type": "integer",
      "initial": 0,
      "min": 0,
      "max": 3
    },
    "pieces": {
      "type": "integer",
      "initial": 0,
      "min": 0,
      "max": 13
    },
    "verb": {
      "type": "enum",
      "values": [
        "none",
        "free",
        "release",
        "unhex",
        "disenchant"
      ],
      "initial": "none"
    },
    "who": {
      "type": "enum",
      "values": [
        "none",
        "tavi",
        "weaver",
        "both"
      ],
      "initial": "none"
    },
    "from": {
      "type": "enum",
      "values": [
        "none",
        "loom",
        "enchanted"
      ],
      "initial": "none"
    }
  },
  "actions": {
    "lift": {
      "when": {
        "op": "eq",
        "left": {
          "field": "phase"
        },
        "right": "guided"
      },
      "branches": [
        {
          "when": {
            "op": "eq",
            "left": {
              "field": "lifted"
            },
            "right": 2
          },
          "effects": [
            {
              "op": "add",
              "field": "lifted",
              "value": 1
            },
            {
              "op": "set",
              "field": "phase",
              "value": "predict"
            }
          ],
          "emits": [
            "piece-lifted",
            "band-weaves"
          ]
        },
        {
          "effects": [
            {
              "op": "add",
              "field": "lifted",
              "value": 1
            }
          ],
          "emits": [
            "piece-lifted"
          ]
        }
      ]
    },
    "predict.words": {
      "when": {
        "op": "eq",
        "left": {
          "field": "phase"
        },
        "right": "predict"
      },
      "effects": [
        {
          "op": "set",
          "field": "phase",
          "value": "build"
        }
      ],
      "emits": [
        "decide:predict-pieces:wrong:one-per-word",
        "loom-splits"
      ]
    },
    "predict.pieces": {
      "when": {
        "op": "eq",
        "left": {
          "field": "phase"
        },
        "right": "predict"
